{
  "opencollection": "1.0.0",
  "info": {
    "name": "AWeber Accounts API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "authorization_code",
      "authorizationUrl": "https://auth.aweber.com/oauth2/authorize",
      "accessTokenUrl": "https://auth.aweber.com/oauth2/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Accounts",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get accounts",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.aweber.com/1.0/accounts",
            "params": [
              {
                "name": "ws.start",
                "value": "",
                "type": "query",
                "description": "The pagination starting offset"
              },
              {
                "name": "ws.size",
                "value": "",
                "type": "query",
                "description": "The pagination total entries to retrieve"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "authorization_code",
              "authorizationUrl": "https://auth.aweber.com/oauth2/authorize",
              "accessTokenUrl": "https://auth.aweber.com/oauth2/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "This endpoint is used to get a paginated collection of accounts.\n\nCheck out examples for <a href=\"https://github.com/aweber/public-api-examples/tree/master/python\" target=\"_blank\">Python</a>,\n<a href=\"https://github.com/aweber/public-api-examples/tree/master/php\" target=\"_blank\">PHP</a>,\n<a href=\"https://github.com/aweber/public-api-examples/tree/master/postman\" target=\"_blank\">Postman</a>,\n<a href=\"https://github.com/aweber/public-api-examples/tree/master/csharp\" target=\"_blank\">C#.NET</a>,\n<a "
        },
        {
          "info": {
            "name": "Get account",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.aweber.com/1.0/accounts/:accountId",
            "params": [
              {
                "name": "accountId",
                "value": "",
                "type": "path",
                "description": "The account ID"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "authorization_code",
              "authorizationUrl": "https://auth.aweber.com/oauth2/authorize",
              "accessTokenUrl": "https://auth.aweber.com/oauth2/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "This endpoint is used to retrieve information for a specific account.\n\nCheck out examples for <a href=\"https://github.com/aweber/public-api-examples/tree/master/python\" target=\"_blank\">Python</a>,\n<a href=\"https://github.com/aweber/public-api-examples/tree/master/php\" target=\"_blank\">PHP</a>,\n<a href=\"https://github.com/aweber/public-api-examples/tree/master/postman\" target=\"_blank\">Postman</a>,\n<a href=\"https://github.com/aweber/public-api-examples/tree/master/csharp\" target=\"_blank\">C#.NET</a>"
        }
      ]
    }
  ],
  "bundled": true
}